@startuml
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0

' ============================================================
' MODEL (SQLAlchemy Entities) - backend/app/models/
' ============================================================
package "MODEL" {

  class Aluno <<Entity>> {
    - id_aluno : int (PK, column: idaluno)
    - nome : str (NOT NULL)
    - telefone : str ?
    - data_nascimento : date ? (column: nascimento)
    - rua : str ?
    - bairro : str ?
    - numero : int ?
    + get_id_aluno() : int
    + get_nome() : str
    + get_telefone() : str?
    + get_data_nascimento() : date?
    + get_rua() : str?
    + get_bairro() : str?
    + get_numero() : int?
    + set_id_aluno(id: int) : void
    + set_nome(nome: str) : void
    + set_telefone(telefone: str?) : void
    + set_data_nascimento(data: date?) : void
    + set_rua(rua: str?) : void
    + set_bairro(bairro: str?) : void
    + set_numero(numero: int?) : void
  }

  class Curso <<Entity>> {
    - id_curso : int (PK, column: idcurso)
    - nome_curso : str (NOT NULL, column: nomecurso)
    + get_id_curso() : int
    + get_nome_curso() : str
    + set_id_curso(id: int) : void
    + set_nome_curso(nome: str) : void
  }

  class Turma <<Entity>> {
    - id_turma : int (PK, column: idturma)
    - capacidade : int ?
    - data_inicio : date ? (column: datainicio)
    - data_fim : date ? (column: datafim)
    - id_curso : int (FK, column: idcurso)
    - id_professor : int ? (FK, column: idprofessor)
    - dias_aula : str ? (column: diasaula)
    - avaliacoes : list ? (JSONB)
    + vagas_ocupadas : int (readonly)
    + get_id_turma() : int
    + get_capacidade() : int?
    + get_data_inicio() : date?
    + get_data_fim() : date?
    + get_id_curso() : int
    + get_id_professor() : int?
    + get_dias_aula() : str?
    + get_avaliacoes() : list?
    + get_vagas_ocupadas() : int
    + set_id_turma(id: int) : void
    + set_capacidade(capacidade: int?) : void
    + set_data_inicio(data: date?) : void
    + set_data_fim(data: date?) : void
    + set_id_curso(id: int) : void
    + set_id_professor(id: int?) : void
    + set_dias_aula(dias: str?) : void
    + set_avaliacoes(avaliacoes: list?) : void
  }

  class Matricula <<Entity>> {
    - id_matricula : int (PK, column: idmatricula)
    - id_aluno : int (FK, column: idaluno)
    - id_turma : int (FK, column: idturma)
    - data_matricula : date ? (column: datamatricula)
    - status : int ?
    + get_id_matricula() : int
    + get_id_aluno() : int
    + get_id_turma() : int
    + get_data_matricula() : date?
    + get_status() : int?
    + set_id_matricula(id: int) : void
    + set_id_aluno(id: int) : void
    + set_id_turma(id: int) : void
    + set_data_matricula(data: date?) : void
    + set_status(status: int?) : void
  }

  class Nota <<Entity>> {
    - id_nota : int (PK, column: idnota)
    - nota : float ?
    - prova : int ?
    - id_matricula : int (FK, column: idmatricula)
    + get_id_nota() : int
    + get_nota() : float?
    + get_prova() : int?
    + get_id_matricula() : int
    + set_id_nota(id: int) : void
    + set_nota(nota: float?) : void
    + set_prova(prova: int?) : void
    + set_id_matricula(id: int) : void
  }

  class Presenca <<Entity>> {
    - id_presenca : int (PK, column: idpresenca)
    - id_matricula : int (FK, column: idmatricula)
    - data_aula : date ? (column: dataaula)
    - presente : bool ?
    + get_id_presenca() : int
    + get_id_matricula() : int
    + get_data_aula() : date?
    + get_presente() : bool?
    + set_id_presenca(id: int) : void
    + set_id_matricula(id: int) : void
    + set_data_aula(data: date?) : void
    + set_presente(presente: bool?) : void
  }

  class Usuario <<Entity>> {
    - id_usuario : int (PK, column: idusuario)
    - nome : str ?
    - telefone : str ?
    - email : str ? (UNIQUE)
    - senha_hash : str ? (column: senhahash)
    - cargo : int ?
    + get_id_usuario() : int
    + get_nome() : str?
    + get_telefone() : str?
    + get_email() : str?
    + get_senha_hash() : str?
    + get_cargo() : int?
    + set_id_usuario(id: int) : void
    + set_nome(nome: str?) : void
    + set_telefone(telefone: str?) : void
    + set_email(email: str?) : void
    + set_senha_hash(hash: str?) : void
    + set_cargo(cargo: int?) : void
  }

  class Pedido <<Entity>> {
    - id_pedido : int (PK, column: idpedido)
    - id_usuario : int (FK, column: idusuario)
    - id_turma : int (FK, column: idturma)
    - data_pedido : date ? (column: datapedido)
    - status : int ?
    + get_id_pedido() : int
    + get_id_usuario() : int
    + get_id_turma() : int
    + get_data_pedido() : date?
    + get_status() : int?
    + set_id_pedido(id: int) : void
    + set_id_usuario(id: int) : void
    + set_id_turma(id: int) : void
    + set_data_pedido(data: date?) : void
    + set_status(status: int?) : void
  }

  class ItemPedido <<Entity>> {
    - id_item_pedido : int (PK, column: iditempedido)
    - id_pedido : int (FK, column: idpedido)
    - id_item_estoque : int ? (FK, column: iditemestoque)
    - nome_item : str ? (column: nomeitem)
    - quantidade : int ?
    - preco_unitario : float ? (column: precounitario)
    + get_id_item_pedido() : int
    + get_id_pedido() : int
    + get_id_item_estoque() : int?
    + get_nome_item() : str?
    + get_quantidade() : int?
    + get_preco_unitario() : float?
    + set_id_item_pedido(id: int) : void
    + set_id_pedido(id: int) : void
    + set_id_item_estoque(id: int?) : void
    + set_nome_item(nome: str?) : void
    + set_quantidade(qtd: int?) : void
    + set_preco_unitario(preco: float?) : void
  }

  class Estoque <<Entity>> {
    - id_item_estoque : int (PK, column: iditemestoque)
    - nome_item : str ? (column: nomeitem)
    - quantidade_disponivel : int ? (column: quantidadedisponivel)
    - unidade : str ?
    - estoque_minimo : int ? (column: estoqueminimo)
    + get_id_item_estoque() : int
    + get_nome_item() : str?
    + get_quantidade_disponivel() : int?
    + get_unidade() : str?
    + get_estoque_minimo() : int?
    + set_id_item_estoque(id: int) : void
    + set_nome_item(nome: str?) : void
    + set_quantidade_disponivel(qtd: int?) : void
    + set_unidade(unidade: str?) : void
    + set_estoque_minimo(min: int?) : void
  }

  class MovimentacaoEstoque <<Entity>> {
    - id_movimentacao : int (PK, column: idmovimentacao)
    - id_item_estoque : int (FK, column: iditemestoque)
    - quantidade : int
    - tipo_movimentacao : str (column: tipomovimentacao)
    - justificativa : str ?
    - data_movimentacao : datetime (column: datamovimentacao)
    + get_id_movimentacao() : int
    + get_id_item_estoque() : int
    + get_quantidade() : int
    + get_tipo_movimentacao() : str
    + get_justificativa() : str?
    + get_data_movimentacao() : datetime
    + set_id_movimentacao(id: int) : void
    + set_id_item_estoque(id: int) : void
    + set_quantidade(qtd: int) : void
    + set_tipo_movimentacao(tipo: str) : void
    + set_justificativa(just: str?) : void
    + set_data_movimentacao(data: datetime) : void
  }

  ' ---- Relationships ----
  Aluno "1" -- "0..*" Matricula
  Curso "1" -- "0..*" Turma
  Turma "1" -- "0..*" Matricula
  Turma "0..*" -- "0..1" Usuario : professor
  Turma "1" -- "0..*" Pedido
  Matricula "1" -- "0..*" Nota
  Matricula "1" -- "0..*" Presenca
  Usuario "1" -- "0..*" Pedido : solicitante
  Pedido "1" -- "0..*" ItemPedido
  ItemPedido "0..*" -- "0..1" Estoque
  Estoque "1" -- "0..*" MovimentacaoEstoque
}

' ============================================================
' SCHEMA (Pydantic DTOs) - backend/app/schemas/
' ============================================================
package "SCHEMA" {
  class AlunoCreateSchema <<DTO>> { + nome: str ; + telefone: str? ; + dataNascimento: date? ; + rua: str? ; + bairro: str? ; + numero: int? }
  class AlunoUpdateSchema <<DTO>> { + nome: str? ; + telefone: str? ; + dataNascimento: date? ; + rua: str? ; + bairro: str? ; + numero: int? }
  class AlunoResponseSchema <<DTO>> { + id_aluno (alias idAluno): int ; + nome: str ; + telefone: str? ; + data_nascimento (alias dataNascimento): date? ; + rua: str? ; + bairro: str? ; + numero: int? }

  class CursoCreateSchema <<DTO>> { + nomeCurso: str }
  class CursoUpdateSchema <<DTO>> { + nomeCurso: str }
  class CursoResponseSchema <<DTO>> { + id_curso (alias idCurso): int ; + nome_curso (alias nomeCurso): str }

  class TurmaCreateSchema <<DTO>> { + capacidade: int? ; + dataInicio: date? ; + dataFim: date? ; + idCurso: int ; + idProfessor: int? ; + diasAula: str? ; + avaliacoes: list? }
  class TurmaUpdateSchema <<DTO>> { + capacidade: int? ; + dataInicio: date? ; + dataFim: date? ; + idCurso: int? ; + idProfessor: int? ; + diasAula: str? ; + avaliacoes: list? }
  class TurmaCursoInfo <<DTO>> { + id_curso (alias idCurso): int ; + nome_curso (alias nomeCurso): str }
  class TurmaProfessorInfo <<DTO>> { + id_usuario (alias idUsuario): int ; + nome: str? }
  class TurmaResponseSchema <<DTO>> { + id_turma (alias idTurma): int ; + capacidade: int? ; + data_inicio (alias dataInicio): date? ; + data_fim (alias dataFim): date? ; + id_curso (alias idCurso): int ; + id_professor (alias idProfessor): int? ; + dias_aula (alias diasAula): str? ; + vagas_ocupadas (alias vagasOcupadas): int? ; + avaliacoes: list? ; + curso: TurmaCursoInfo? ; + professor: TurmaProfessorInfo? }

  class MatriculaCreateSchema <<DTO>> { + idAluno: int ; + idTurma: int ; + dataMatricula: date? ; + status: int? }
  class MatriculaUpdateSchema <<DTO>> { + idAluno: int? ; + idTurma: int? ; + dataMatricula: date? ; + status: int? }
  class MatriculaAlunoInfo <<DTO>> { + id_aluno (alias idAluno): int ; + nome: str? ; + telefone: str? }
  class MatriculaCursoInfo <<DTO>> { + id_curso (alias idCurso): int ; + nome_curso (alias nomeCurso): str }
  class MatriculaTurmaInfo <<DTO>> { + id_turma (alias idTurma): int ; + capacidade: int? ; + curso: MatriculaCursoInfo? }
  class MatriculaResponseSchema <<DTO>> { + id_matricula (alias idMatricula): int ; + id_aluno (alias idAluno): int? ; + id_turma (alias idTurma): int? ; + data_matricula (alias dataMatricula): date? ; + status: int? ; + aluno: MatriculaAlunoInfo? ; + turma: MatriculaTurmaInfo? }

  class NotaItemSchema <<DTO>> { + idMatricula: int ; + nota: float? }
  class NotaBatchSchema <<DTO>> { + idTurma: int ; + prova: int ; + notas: list[NotaItemSchema] }
  class NotaAlunoInfo <<DTO>> { + id_aluno (alias idAluno): int ; + nome: str? }
  class NotaTurmaInfo <<DTO>> { + id_turma (alias idTurma): int ; + nome_curso (alias nomeCurso): str? }
  class NotaMatriculaInfo <<DTO>> { + id_matricula (alias idMatricula): int ; + aluno: NotaAlunoInfo? ; + turma: NotaTurmaInfo? }
  class NotaResponseSchema <<DTO>> { + id_nota (alias idNota): int ; + id_matricula (alias idMatricula): int ; + nota: float? ; + prova: int? ; + matricula: NotaMatriculaInfo? }
  class MediaProvaSchema <<DTO>> { + prova: int ; + media: float? }
  class MediaTurmaSchema <<DTO>> { + id_turma (alias idTurma): int ; + medias: list[MediaProvaSchema] }

  class PresencaItemSchema <<DTO>> { + idMatricula: int ; + presente: bool }
  class PresencaBatchSchema <<DTO>> { + idTurma: int ; + dataAula: date ; + presencas: list[PresencaItemSchema] }
  class PresencaAlunoInfo <<DTO>> { + id_aluno (alias idAluno): int ; + nome: str? }
  class PresencaMatriculaInfo <<DTO>> { + id_matricula (alias idMatricula): int ; + aluno: PresencaAlunoInfo? }
  class PresencaResponseSchema <<DTO>> { + id_presenca (alias idPresenca): int ; + id_matricula (alias idMatricula): int ; + data_aula (alias dataAula): date? ; + presente: bool? ; + matricula: PresencaMatriculaInfo? }

  class UsuarioCreateSchema <<DTO>> { + nome: str ; + email: EmailStr ; + senha: str ; + cargo: int ; + telefone: str? }
  class UsuarioUpdateSchema <<DTO>> { + nome: str ; + telefone: str? ; + cargo: int }
  class UsuarioResponseSchema <<DTO>> { + id_usuario (alias idUsuario): int ; + nome: str? ; + telefone: str? ; + email: EmailStr? ; + cargo: int? }

  class ItemPedidoCreateSchema <<DTO>> { + nomeItem: str ; + quantidade: int? ; + idItemEstoque: int? ; + precoUnitario: float? }
  class ItemPedidoCompraSchema <<DTO>> { + idItemPedido: int ; + quantidade: int }
  class PedidoCreateSchema <<DTO>> { + idTurma: int ; + dataPedido: date? ; + itens: list[ItemPedidoCreateSchema] }
  class PedidoUpdateSchema <<DTO>> { + status: int }
  class PedidoCompraSchema <<DTO>> { + itens: list[ItemPedidoCompraSchema] }
  class EstoqueItemInfo <<DTO>> { + id_item_estoque (alias idItemEstoque): int ; + nome_item (alias nomeItem): str? ; + unidade: str? }
  class ItemPedidoResponseSchema <<DTO>> { + id_item_pedido (alias idItemPedido): int ; + id_pedido (alias idPedido): int ; + id_item_estoque (alias idItemEstoque): int? ; + nome_item (alias nomeItem): str? ; + quantidade: int? ; + preco_unitario (alias precoUnitario): float? ; + item_estoque: EstoqueItemInfo? }
  class UsuarioPedidoInfo <<DTO>> { + id_usuario (alias idUsuario): int ; + nome: str? }
  class TurmaPedidoInfo <<DTO>> { + id_turma (alias idTurma): int ; + capacidade: int? ; + nome_curso (alias nomeCurso): str? }
  class PedidoResponseSchema <<DTO>> { + id_pedido (alias idPedido): int ; + id_usuario (alias idUsuario): int ; + id_turma (alias idTurma): int ; + data_pedido (alias dataPedido): date? ; + status: int? ; + usuario: UsuarioPedidoInfo? ; + turma: TurmaPedidoInfo? ; + itens: list[ItemPedidoResponseSchema]? }

  class EstoqueCreateSchema <<DTO>> { + nomeItem: str ; + quantidadeDisponivel: int? ; + unidade: str? ; + estoqueMinimo: int? }
  class EstoqueUpdateSchema <<DTO>> { + nomeItem: str? ; + quantidadeDisponivel: int? ; + unidade: str? ; + estoqueMinimo: int? }
  class EstoqueResponseSchema <<DTO>> { + id_item_estoque (alias idItemEstoque): int ; + nome_item (alias nomeItem): str? ; + quantidade_disponivel (alias quantidadeDisponivel): int? ; + unidade: str? ; + estoque_minimo (alias estoqueMinimo): int? }
  class EstoqueBaixaSchema <<DTO>> { + quantidade: int ; + justificativa: str }
  class EstoqueAlertaResponseSchema <<DTO>> { + id_item_estoque (alias idItemEstoque): int ; + nome_item (alias nomeItem): str? ; + quantidade_disponivel (alias quantidadeDisponivel): int? ; + unidade: str? ; + estoque_minimo (alias estoqueMinimo): int? }

  class LoginRequest <<DTO>> { + email: EmailStr ; + senha: str }
  class ForgotPasswordRequest <<DTO>> { + email: EmailStr }
  class ResetPasswordRequest <<DTO>> { + token: str ; + nova_senha: str ; + confirmar_senha: str }
  class UsuarioResponse <<DTO>> { + idUsuario: int ; + nome: str? ; + email: EmailStr ; + cargo: int? }
  class TokenResponse <<DTO>> { + access_token: str ; + token_type: str = "bearer" ; + usuario: UsuarioResponse }
  class MessageResponse <<DTO>> { + message: str }

  class KpisResponse <<DTO>> { + total_alunos_ativos: int ; + total_turmas_vigentes: int ; + total_pedidos_pendentes: int ; + total_estoque_critico: int }
  class AlunosPorCurso <<DTO>> { + curso: str ; + quantidade: int }
  class StatusMatriculas <<DTO>> { + status: int ; + quantidade: int }
  class ChartAcademicoResponse <<DTO>> { + alunos_por_curso: list[AlunosPorCurso] ; + status_matriculas: list[StatusMatriculas] }
  class ConsumoItem <<DTO>> { + item: str ; + quantidade: int }
  class ChartLogisticaResponse <<DTO>> { + consumo_mes_atual: list[ConsumoItem] }

  class HistoricoNotaInfo <<DTO>> { + prova: int? ; + nota: float? }
  class HistoricoPresencaInfo <<DTO>> { + data_aula (alias dataAula): date? ; + presente: bool? }
  class HistoricoAlunoInfo <<DTO>> { + id_aluno (alias idAluno): int ; + nome: str ; + data_nascimento (alias dataNascimento): date? ; + telefone: str? }
  class HistoricoTurmaInfo <<DTO>> { + id_turma (alias idTurma): int ; + nome_curso (alias nomeCurso): str ; + nome_professor (alias nomeProfessor): str? ; + data_inicio (alias dataInicio): date? ; + data_fim (alias dataFim): date? ; + dias_aula (alias diasAula): str? }
  class HistoricoResponse <<DTO>> { + id_matricula (alias idMatricula): int ; + data_matricula (alias dataMatricula): date? ; + status: int? ; + aluno: HistoricoAlunoInfo ; + turma: HistoricoTurmaInfo ; + notas: list[HistoricoNotaInfo] ; + presencas: list[HistoricoPresencaInfo] ; + percentual_frequencia (alias percentualFrequencia): float? }

  ' ---- Schema compositions ----
  NotaBatchSchema *-- NotaItemSchema
  TurmaResponseSchema *-- TurmaCursoInfo
  TurmaResponseSchema *-- TurmaProfessorInfo
  MatriculaResponseSchema *-- MatriculaAlunoInfo
  MatriculaResponseSchema *-- MatriculaTurmaInfo
  MatriculaTurmaInfo *-- MatriculaCursoInfo
  NotaResponseSchema *-- NotaMatriculaInfo
  NotaMatriculaInfo *-- NotaAlunoInfo
  NotaMatriculaInfo *-- NotaTurmaInfo
  PresencaResponseSchema *-- PresencaMatriculaInfo
  PresencaMatriculaInfo *-- PresencaAlunoInfo
  PedidoResponseSchema *-- UsuarioPedidoInfo
  PedidoResponseSchema *-- TurmaPedidoInfo
  PedidoResponseSchema *-- ItemPedidoResponseSchema
  ItemPedidoResponseSchema *-- EstoqueItemInfo
  PedidoCreateSchema *-- ItemPedidoCreateSchema
  PedidoCompraSchema *-- ItemPedidoCompraSchema
  HistoricoResponse *-- HistoricoAlunoInfo
  HistoricoResponse *-- HistoricoTurmaInfo
  HistoricoResponse *-- HistoricoNotaInfo
  HistoricoResponse *-- HistoricoPresencaInfo
  ChartAcademicoResponse *-- AlunosPorCurso
  ChartAcademicoResponse *-- StatusMatriculas
  ChartLogisticaResponse *-- ConsumoItem
  MediaTurmaSchema *-- MediaProvaSchema
}

' ============================================================
' CONTROLLER (FastAPI Routers) - backend/app/api/v1/
' ============================================================
package "CONTROLLER" {
  class AuthRouter {
    + login(payload: LoginRequest, request, db) : TokenResponse
    + forgot_password(payload: ForgotPasswordRequest, request, db) : MessageResponse
    + reset_password(payload: ResetPasswordRequest, request, db) : MessageResponse
  }

  class AlunoRouter {
    + read_alunos(current_user, db) : list[AlunoResponseSchema]
    + read_aluno(aluno_id, current_user, db) : AlunoResponseSchema
    + create_alunos(payload: AlunoCreateSchema, current_user, db) : AlunoResponseSchema
    + update_alunos(aluno_id, payload: AlunoUpdateSchema, current_user, db) : AlunoResponseSchema
    + delete_alunos(aluno_id, current_user, db) : dict
  }

  class CursoRouter {
    + read_cursos(current_user, db) : list[CursoResponseSchema]
    + read_curso(curso_id, current_user, db) : CursoResponseSchema
    + create_cursos(payload: CursoCreateSchema, current_user, db) : CursoResponseSchema
    + update_cursos(curso_id, payload: CursoUpdateSchema, current_user, db) : CursoResponseSchema
    + delete_cursos(curso_id, current_user, db) : dict
  }

  class TurmaRouter {
    + read_turmas(current_user, db) : list[TurmaResponseSchema]
    + read_minhas_turmas(current_user, db) : list[TurmaResponseSchema]
    + read_turma(turma_id, current_user, db) : TurmaResponseSchema
    + create_turmas(payload: TurmaCreateSchema, current_user, db) : TurmaResponseSchema
    + update_turmas(turma_id, payload: TurmaUpdateSchema, current_user, db) : TurmaResponseSchema
    + delete_turmas(turma_id, current_user, db) : dict
  }

  class MatriculaRouter {
    + read_matriculas(current_user, db) : list[MatriculaResponseSchema]
    + read_matriculas_by_professor(current_user, db) : list[MatriculaResponseSchema]
    + read_matricula(matricula_id, current_user, db) : MatriculaResponseSchema
    + create_matriculas(payload: MatriculaCreateSchema, current_user, db) : MatriculaResponseSchema
    + update_matriculas(matricula_id, payload: MatriculaUpdateSchema, current_user, db) : MatriculaResponseSchema
    + delete_matriculas(matricula_id, current_user, db) : dict
  }

  class NotaRouter {
    + create_notas(payload: NotaBatchSchema, current_user, db) : list[NotaResponseSchema]
    + read_notas_by_matricula(matricula_id, current_user, db) : list[NotaResponseSchema]
    + read_notas_by_turma(turma_id, prova, current_user, db) : list[NotaResponseSchema]
    + read_media_turma(turma_id, current_user, db) : MediaTurmaSchema
  }

  class PresencaRouter {
    + create_presencas(payload: PresencaBatchSchema, current_user, db) : list[PresencaResponseSchema]
    + read_presencas_by_turma(turma_id, dataAula, current_user, db) : list[PresencaResponseSchema]
  }

  class UsuarioRouter {
    + read_usuarios(current_user, db) : list[UsuarioResponseSchema]
    + read_usuario(usuario_id, current_user, db) : UsuarioResponseSchema
    + create_usuarios(payload: UsuarioCreateSchema, current_user, db) : UsuarioResponseSchema
    + update_usuarios(usuario_id, payload: UsuarioUpdateSchema, current_user, db) : UsuarioResponseSchema
    + delete_usuarios(usuario_id, current_user, db) : dict
  }

  class PedidoRouter {
    + read_pedidos(current_user, db) : list[PedidoResponseSchema]
    + read_pedido(pedido_id, current_user, db) : PedidoResponseSchema
    + create_pedidos(payload: PedidoCreateSchema, current_user, db) : PedidoResponseSchema
    + aprovar_pedido_endpoint(pedido_id, current_user, db) : PedidoResponseSchema
    + comprar_pedido_endpoint(pedido_id, payload: PedidoCompraSchema, current_user, db) : PedidoResponseSchema
    + update_pedidos(pedido_id, payload: PedidoUpdateSchema, current_user, db) : PedidoResponseSchema
    + entregar_pedido_endpoint(pedido_id, current_user, db) : PedidoResponseSchema
    + delete_pedidos(pedido_id, current_user, db) : dict
  }

  class EstoqueRouter {
    + read_estoque(current_user, db) : list[EstoqueResponseSchema]
