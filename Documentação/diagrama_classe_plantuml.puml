@startuml
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11
hide empty members

package "app" {

  package "models" as models {
    package "aluno.py" { class Aluno }
    package "curso.py" { class Curso }
    package "turma.py" { class Turma }
    package "matricula.py" { class Matricula }
    package "nota.py" { class Nota }
    package "presenca.py" { class Presenca }
    package "usuario.py" { class Usuario }
    package "pedido.py" { class Pedido }
    package "item_pedido.py" { class ItemPedido }
    package "estoque.py" { class Estoque }
    package "movimentacao_estoque.py" { class MovimentacaoEstoque }
  }

  package "schemas" as schemas {
    package "aluno_schema.py" { class AlunoCreateSchema ; class AlunoUpdateSchema ; class AlunoResponseSchema }
    package "auth_schema.py" { class LoginRequest ; class TokenResponse ; class MessageResponse }
    package "curso_schema.py" { class CursoCreateSchema ; class CursoUpdateSchema ; class CursoResponseSchema }
    package "dashboard_schema.py" { class KpisResponse ; class ChartAcademicoResponse ; class ChartLogisticaResponse }
    package "estoque_schema.py" { class EstoqueCreateSchema ; class EstoqueUpdateSchema ; class EstoqueResponseSchema ; class EstoqueBaixaSchema }
    package "historico_schema.py" { class HistoricoNotaInfo ; class HistoricoAlunoInfo ; class HistoricoTurmaInfo ; class HistoricoResponse }
    package "matricula_schema.py" { class MatriculaCreateSchema ; class MatriculaUpdateSchema ; class MatriculaAlunoInfo ; class MatriculaCursoInfo ; class MatriculaTurmaInfo ; class MatriculaResponseSchema }
    package "nota_schema.py" { class NotaItemSchema ; class NotaBatchSchema ; class NotaAlunoInfo ; class NotaResponseSchema ; class MediaProvaSchema ; class MediaTurmaSchema }
    package "pedido_schema.py" { class PedidoCreateSchema ; class PedidoUpdateSchema ; class PedidoCompraSchema ; class ItemPedidoCreateSchema ; class ItemPedidoResponseSchema ; class PedidoResponseSchema }
    package "presenca_schema.py" { class PresencaItemSchema ; class PresencaBatchSchema ; class PresencaAlunoInfo ; class PresencaResponseSchema }
    package "turma_schema.py" { class TurmaCreateSchema ; class TurmaUpdateSchema ; class TurmaCursoInfo ; class TurmaProfessorInfo ; class TurmaResponseSchema }
    package "usuario_schema.py" { class UsuarioCreateSchema ; class UsuarioUpdateSchema ; class UsuarioResponseSchema }
  }

  package "api" as api {
    package "v1" as v1 {
      package "auth.py" { class AuthRouter }
      package "alunos.py" { class AlunoRouter }
      package "cursos.py" { class CursoRouter }
      package "turmas.py" { class TurmaRouter }
      package "matriculas.py" { class MatriculaRouter }
      package "notas.py" { class NotaRouter }
      package "presencas.py" { class PresencaRouter }
      package "usuarios.py" { class UsuarioRouter }
      package "pedidos.py" { class PedidoRouter }
      package "estoque.py" { class EstoqueRouter }
      package "dashboard.py" { class DashboardRouter }
      package "historico.py" { class HistoricoRouter }
    }
  }

  package "core" as core {
    package "config.py" { class Settings }
    package "security.py" { class SecurityUtils }
    package "dependencies.py" { class AuthDependencies }
    package "limiter.py" { class RateLimiter }
  }

  package "db" as db {
    package "database.py" { class Database }
  }

  package "services" as services {
    package "auth_service.py" { class AuthService }
    package "aluno_service.py" { class AlunoService }
    package "curso_service.py" { class CursoService }
    package "turma_service.py" { class TurmaService }
    package "matricula_service.py" { class MatriculaService }
    package "nota_service.py" { class NotaService }
    package "presenca_service.py" { class PresencaService }
    package "usuario_service.py" { class UsuarioService }
    package "pedido_service.py" { class PedidoService }
    package "estoque_service.py" { class EstoqueService }
    package "dashboard_service.py" { class DashboardService }
    package "historico_service.py" { class HistoricoService }
    package "email_service.py" { class EmailService }
  }
}

Aluno --> Matricula
Curso --> Turma
Turma --> Matricula
Turma --> Usuario : professor
Turma --> Pedido
Matricula --> Nota
Matricula --> Presenca
Usuario --> Pedido : solicitante
Pedido --> ItemPedido
ItemPedido --> Estoque
Estoque --> MovimentacaoEstoque

AuthRouter --> AuthService
AuthRouter --> EmailService
AlunoRouter --> AlunoService
CursoRouter --> CursoService
TurmaRouter --> TurmaService
MatriculaRouter --> MatriculaService
NotaRouter --> NotaService
PresencaRouter --> PresencaService
UsuarioRouter --> UsuarioService
PedidoRouter --> PedidoService
EstoqueRouter --> EstoqueService
DashboardRouter --> DashboardService
HistoricoRouter --> HistoricoService

AuthRouter --> AuthDependencies
AuthRouter --> RateLimiter
AlunoRouter --> AuthDependencies
CursoRouter --> AuthDependencies
TurmaRouter --> AuthDependencies
MatriculaRouter --> AuthDependencies
NotaRouter --> AuthDependencies
PresencaRouter --> AuthDependencies
UsuarioRouter --> AuthDependencies
PedidoRouter --> AuthDependencies
EstoqueRouter --> AuthDependencies
DashboardRouter --> AuthDependencies
HistoricoRouter --> AuthDependencies

AuthService --> Usuario
AuthService --> Database
AuthService --> SecurityUtils
AlunoService --> Aluno
AlunoService --> Database
CursoService --> Curso
CursoService --> Database
TurmaService --> Turma
TurmaService --> Curso
TurmaService --> Usuario
TurmaService --> Database
MatriculaService --> Aluno
MatriculaService --> Turma
MatriculaService --> Database
NotaService --> Nota
NotaService --> Matricula
NotaService --> Database
PresencaService --> Presenca
PresencaService --> Matricula
PresencaService --> Database
UsuarioService --> Usuario
UsuarioService --> Database
PedidoService --> Pedido
PedidoService --> ItemPedido
PedidoService --> Database
EstoqueService --> Estoque
EstoqueService --> MovimentacaoEstoque
EstoqueService --> Database
DashboardService --> Turma
DashboardService --> Pedido
DashboardService --> Estoque
DashboardService --> Matricula
DashboardService --> Database
HistoricoService --> Matricula
HistoricoService --> Aluno
HistoricoService --> Turma
HistoricoService --> Nota
HistoricoService --> Presenca
HistoricoService --> Database
EmailService --> Settings

AuthDependencies --> SecurityUtils
AuthDependencies --> Settings
Database --> Settings

@enduml
