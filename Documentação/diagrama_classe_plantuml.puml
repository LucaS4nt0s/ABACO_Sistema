' DB - backend/app/db/
' ============================================================
package "db" {

  package "database.py" {
    class Database <<Infrastructure>> {
      + engine : Engine
      + SessionLocal : sessionmaker
      + Base : declarative_base
      + get_db() : Generator[Session]
    }
  }
}

