    %% ============================================================
    %% API / V1 - backend/app/api/v1/
    %% Namespace por arquivo .py
    %% ============================================================

    namespace auth {
        class AuthRouter {
            <<Controller>>
            +login(payload: LoginRequest, request, db) TokenResponse
            +forgot_password(payload: ForgotPasswordRequest, request, db) MessageResponse
            +reset_password(payload: ResetPasswordRequest, request, db) MessageResponse
        }
    }

    namespace alunos {
        class AlunoRouter {
            <<Controller>>
            +read_alunos(current_user, db) list
            +read_aluno(aluno_id, current_user, db) AlunoResponseSchema
            +create_alunos(payload: AlunoCreateSchema, current_user, db) AlunoResponseSchema
            +update_alunos(aluno_id, payload: AlunoUpdateSchema, current_user, db) AlunoResponseSchema
            +delete_alunos(aluno_id, current_user, db) dict
        }
    }

    namespace cursos {
        class CursoRouter {
            <<Controller>>
            +read_cursos(current_user, db) list
            +read_curso(curso_id, current_user, db) CursoResponseSchema
            +create_cursos(payload: CursoCreateSchema, current_user, db) CursoResponseSchema
            +update_cursos(curso_id, payload: CursoUpdateSchema, current_user, db) CursoResponseSchema
            +delete_cursos(curso_id, current_user, db) dict
        }
    }

    namespace turmas {
        class TurmaRouter {
            <<Controller>>
            +read_turmas(current_user, db) list
            +read_minhas_turmas(current_user, db) list
            +read_turma(turma_id, current_user, db) TurmaResponseSchema
            +create_turmas(payload: TurmaCreateSchema, current_user, db) TurmaResponseSchema
            +update_turmas(turma_id, payload: TurmaUpdateSchema, current_user, db) TurmaResponseSchema
            +delete_turmas(turma_id, current_user, db) dict
        }
    }

    namespace matriculas {
        class MatriculaRouter {
            <<Controller>>
            +read_matriculas(current_user, db) list
            +read_matriculas_by_professor(current_user, db) list
            +read_matricula(matricula_id, current_user, db) MatriculaResponseSchema
            +create_matriculas(payload: MatriculaCreateSchema, current_user, db) MatriculaResponseSchema
            +update_matriculas(matricula_id, payload: MatriculaUpdateSchema, current_user, db) MatriculaResponseSchema
            +delete_matriculas(matricula_id, current_user, db) dict
        }
    }

    namespace notas {
        class NotaRouter {
            <<Controller>>
            +create_notas(payload: NotaBatchSchema, current_user, db) list
            +read_notas_by_matricula(matricula_id, current_user, db) list
            +read_notas_by_turma(turma_id, prova?, current_user, db) list
            +read_media_turma(turma_id, current_user, db) MediaTurmaSchema
        }
